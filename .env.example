# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta app (App settings → Basic → App secret)
META_APP_SECRET=
# Any random string you choose; enter the same value in Meta's webhook config
META_VERIFY_TOKEN=

# WhatsApp Cloud API (WhatsApp → API Setup)
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (needed to load templates for broadcasts)
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Permanent token from a System User with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_GRAPH_VERSION=v21.0

# AI — use Gemini OR OpenAI. If GEMINI_API_KEY is set, Gemini is used.
# Gemini key (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Country code added to 10-digit numbers in broadcast lists
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91

# Optional: how long to wait for more messages before replying (ms)
# REPLY_DEBOUNCE_MS=4000
